<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="calendar" android:enabled="true" android:icon="@drawable/ic_sc_calendar"
        android:shortcutShortLabel="@string/sc_calendar" android:shortcutLongLabel="@string/sc_calendar">
        <intent android:action="app.assistant.OPEN" android:targetPackage="app.assistant" android:targetClass="app.assistant.MainActivity">
            <extra android:name="open" android:value="calendar" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="alarms" android:enabled="true" android:icon="@drawable/ic_sc_alarm"
